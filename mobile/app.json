{
  "expo": {
    "name": "Gas Store",
    "slug": "gas-store-mobile",
    "scheme": "gasstore",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.gasstore.mobile",
      "minSdkVersion": 26,
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

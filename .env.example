# Copy to `.env` in this folder for docker compose variable substitution (optional).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gas_store

# Published ports
API_PORT=8000
WEB_PORT=8686
POSTGRES_PORT=5432

# Comma-separated browser origins allowed by FastAPI CORS
CORS_ORIGINS=http://localhost:8686,http://127.0.0.1:8686,http://localhost:5173,http://127.0.0.1:5173

# First boot only — set via ./setup.sh --admin-user ... --admin-pass ... (do not commit real values)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Auth session length (defaults: access 7 days, refresh ~10 years)
# JWT_ACCESS_TOKEN_MINUTES=10080
# JWT_REFRESH_TOKEN_DAYS=3650

# Optional: HTTP User-Agent sent to OSM Nominatim when staff search addresses (usage policy).
# NOMINATIM_USER_AGENT=YourStore/1.0 (contact: you@example.com)

# OCR đơn viết tay qua OpenRouter (https://openrouter.ai/keys). Model free có giới hạn lượt/ngày.
# OPENROUTER_API_KEY=
# OCR_LLM_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Windows: auto-start Docker + tunnel (see docs/deploy/windows.md)
# CLOUDFLARE_TUNNEL_TOKEN=
